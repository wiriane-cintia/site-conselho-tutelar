<section class="busca-bairro" aria-labelledby="titulo-busca">
  <h2 class="apenas-leitor" id="titulo-busca"><%= bairros.titulo %></h2>

  <div class="busca-bairro__linha">
    <label class="apenas-leitor" for="campo-bairro"><%= bairros.titulo %></label>
    <span class="busca-bairro__caixa">
      <svg class="busca-bairro__lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
      <input
        type="text"
        id="campo-bairro"
        class="busca-bairro__campo"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="<%= bairros.titulo %>"
        data-placeholder-curto="<%= bairros.titulo_curto || bairros.titulo %>"
      >
      <button type="button" class="busca-bairro__limpar" id="limpar-busca" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
        <span class="apenas-leitor">Limpar a busca</span>
      </button>
    </span>

    <button type="button" class="busca-bairro__alternar" id="alternar-lista" aria-expanded="false" aria-controls="lista-bairros" hidden>
      <span
        class="busca-bairro__alternar-texto"
        data-rotulo-fechado="<%= bairros.rotulo_lista || 'Listar bairros' %>"
        data-rotulo-aberto="<%= bairros.rotulo_lista_aberta || 'Fechar lista' %>"
      ><%= bairros.rotulo_lista || 'Listar bairros' %></span>
      <svg class="busca-bairro__seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
  </div>

  <p class="busca-bairro__contador" id="contador-bairros" role="status" aria-live="polite"></p>

  <ul class="busca-bairro__lista" id="lista-bairros">
    <% bairros.bairros.forEach(function (bairro) { %>
      <li class="busca-bairro__item" data-nome="<%= bairro.nome %>" data-conselho="<%= bairro.conselho || '' %>">
        <button type="button" class="busca-bairro__botao"><%= bairro.nome %></button>
        <span class="busca-bairro__sem-js">
          — <%= bairro.conselho ? conselhos[bairro.conselho].nome : 'ligue para qualquer um dos dois conselhos' %>
        </span>
      </li>
    <% }); %>
  </ul>

  <div class="busca-bairro__resultado" id="resultado-bairro" tabindex="-1" role="status" aria-live="polite" hidden>
    <p class="busca-bairro__resultado-titulo" id="resultado-titulo"></p>

    <% ['conselho_1', 'conselho_2'].forEach(function (chave) { %>
      <div class="busca-bairro__ficha" id="ficha-<%= chave %>" hidden>
        <ul class="secao-contatos__lista">
          <% conselhos[chave].telefones.forEach(function (tel, i) { %>
            <li><%- include('telefone', { href: 'tel:' + conselhos[chave].telefones_link[i], rotulo: tel, tipo: 'telefone', confirmado: conselhos[chave].telefones_confirmados !== false }) %></li>
          <% }); %>
          <li><%- include('telefone', { href: 'https://wa.me/' + conselhos[chave].plantao_24h_link + '?text=Ol%C3%A1%2C%20preciso%20de%20ajuda', rotulo: 'Plantão 24h — ' + conselhos[chave].plantao_24h, tipo: 'whatsapp' }) %></li>
          <% if (conselhos[chave].endereco) { %>
            <li><%- include('endereco', { texto: conselhos[chave].endereco, mapa: conselhos[chave].endereco_mapa }) %></li>
          <% } %>
        </ul>
      </div>
    <% }); %>

    <div class="busca-bairro__ficha" id="ficha-indefinido" hidden>
      <p>Esse bairro ainda não está dividido entre os dois conselhos. Ligue para qualquer um deles: os dois atendem e fazem o encaminhamento.</p>
      <p><a href="/contato" class="botao botao--contorno">Ver os contatos dos dois conselhos</a></p>
    </div>
  </div>

  <div class="busca-bairro__vazio" id="sem-resultado" role="status" aria-live="polite" hidden>
    <p><strong>Não encontramos esse bairro na lista.</strong></p>
    <p><%= bairros.aviso %></p>
    <p><a href="/contato" class="botao botao--contorno">Ver os contatos dos dois conselhos</a></p>
  </div>
</section>